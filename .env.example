# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
MORPHFOLIO_OWNER_EMAIL=

# OpenRouter — server-side only; never expose with NEXT_PUBLIC_
OPENROUTER_API_KEY=
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_ARCHITECT_MODEL=
OPENROUTER_REVIEW_MODEL=

# Supabase — publishable key is safe for browser use when RLS is enabled
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GitHub App — private key stays server-side
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
